{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["cdg1"],
  "buildCommand": "env -u RELAIS_KEY -u MDBLIST_API_KEY -u QUALITE -u RENDUS_MINUTE -u RENDUS_HEURE npm test",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/qualite/:type/:video.json", "destination": "/api/qualite?type=:type&video=:video" },
    { "source": "/tendances/:type.json", "destination": "/api/tendances?type=:type" },
    { "source": "/notes/:imdb.json", "destination": "/api/notes?imdb=:imdb" },
    { "source": "/vf.json", "destination": "/api/vf" },
    { "source": "/:type/:shape/:id.jpg", "destination": "/api/affiche?type=:type&shape=:shape&id=:id" }
  ],
  "functions": {
    "api/affiche.js": { "includeFiles": "{fonts/**,node_modules/harfbuzzjs/hb.wasm,node_modules/satori/yoga.wasm,lib/dessin.js,lib/habillage.js,lib/polices.js,package.json}" },
    "api/qualite.js": { "regions": ["iad1"] }
  },
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- ."
}
