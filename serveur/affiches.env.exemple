# Secrets du serveur des affiches : copié en /etc/affiches.env par installer.sh (droits 640, root:affiches).
# Jamais dans le dépôt.
TMDB_API_KEY=
# La même valeur que le secret RELAIS_KEY de l'addon : le Worker « affiches » et l'addon l'envoient (X-Relais-Cle).
RELAIS_KEY=
# Publication des affiches statiques : jeton Cloudflare (Workers Scripts et D1 en écriture).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=1d2569d3fe4c915bab43a6ec1bda89da
D1_AFFICHES=48910808-85ba-4ca9-9a3a-76bdecb3475b
# Notes Rotten Tomatoes, Metacritic, Letterboxd (style « Posters+ ») : facultatif.
MDBLIST_API_KEY=
# Écrit par installer.sh : l'adresse https du serveur, donnée au Worker à sa première publication.
SERVEUR_URL=
